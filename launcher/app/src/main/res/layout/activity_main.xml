<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Today's photo of the day behind everything (home_photo); its scrim is baked into the bitmap. -->
    <ImageView
        android:id="@+id/homePhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- The focused card's large picture, over the photo, and the shade that keeps the hero's text readable. -->
    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim"
        android:alpha="0" />

    <!-- Home's sections, one under the other; Home moves the column itself so the focused one sits at the same
         height (MainActivity.scrollTo). -->
    <com.gathin.tvhome.Column
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </com.gathin.tvhome.Column>

    <!-- The focused card: its title, where it comes from and a few words about it, as on Google TV. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/home_margin"
        android:layout_marginTop="128dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/heroSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/heroDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/home_margin"
        android:paddingEnd="@dimen/home_margin"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <!-- Weather ("☀️ 22° · Madrid"), shown once it has loaded. -->
                        <TextView
                            android:id="@+id/weather"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format"
                            android:format24Hour="@string/date_format"
                            android:textColor="#A6FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <!-- Whose items the shelf shows, as their picture or initial; only with two or more profiles in
                     private.json. -->
                <ImageView
                    android:id="@+id/btnProfile"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:padding="3dp"
                    android:background="@drawable/profile_ring"
                    android:focusable="true"
                    android:clickable="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <!-- Wi-Fi keeps its label (the network name); Inputs and Settings are round icon buttons. -->
                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings" />
            </LinearLayout>

            <!-- The now playing pill (NowPlayingCard, now_playing), right under the buttons while music plays.
                 Empty and zero high otherwise. -->
            <FrameLayout
                android:id="@+id/nowSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/topButtons"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="12dp" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Where today's photo was taken and who took it: one faint, very small line at the bottom right, while the
         photo shows (no card's picture over it). -->
    <TextView
        android:id="@+id/photoCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="5dp"
        android:maxWidth="560dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#66FFFFFF"
        android:textSize="9sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.02"
        android:alpha="0" />

    <!-- A small non-modal move hint: Home stays visible and the app or section moves underneath it. -->
    <TextView
        android:id="@+id/reorderHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/glass_panel"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/reorder_hint"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600"
        android:letterSpacing="0.03"
        android:visibility="gone" />
</FrameLayout>
